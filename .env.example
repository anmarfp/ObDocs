# Ambiente da Aplicação
NODE_ENV=development
PORT=3001

# Banco de Dados Local (PostgreSQL via Docker)
POSTGRES_USER=docsob_user
POSTGRES_PASSWORD=docsob_password
POSTGRES_DB=docsob_db
DATABASE_URL="postgresql://docsob_user:docsob_password@localhost:5432/docsob_db?schema=public"

# Autenticação JWT
JWT_SECRET="docsob-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Armazenamento de Arquivos
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=10485760

# Configurações de E-mail (Opcional no dev)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="DocsOb <alertas@docsob.com.br>"
