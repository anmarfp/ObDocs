{
  "name": "docsob-backend",
  "version": "1.0.0",
  "description": "Backend API para o sistema DocsOb de Gestão de Vencimento de Documentos",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
